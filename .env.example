# Copie para .env.local (nunca commite esse arquivo) ou rode:
#   npx vercel link && npx vercel env pull .env.local
# Na Vercel, cadastre em Settings > Environment Variables.
# Também são aceitos os nomes criados pela integração Supabase <-> Vercel
# (NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY etc.).
# NUNCA use a service_role key aqui.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key
